{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "offline-experiment-result-v1",
  "type": "object",
  "required": ["generated_at", "branch", "commit_base", "configuration", "online_experiments", "cases", "metrics", "duration_ms", "limitations"],
  "properties": {
    "generated_at": {"type": "string"},
    "branch": {"type": "string"},
    "commit_base": {"type": "string"},
    "configuration": {"type": "object"},
    "online_experiments": {"const": "Experimentos online: não executados."},
    "cases": {"type": "array", "minItems": 20},
    "metrics": {"type": "object"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "limitations": {"type": "array", "minItems": 1}
  },
  "additionalProperties": false
}
